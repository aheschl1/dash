# admindash environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# This file is loaded into the container via the compose `env_file:` entry. It is
# the DEFAULT/bootstrap config; the agent's LLM endpoint + model can also be
# changed at runtime from the dashboard (gear icon in the assistant panel), which
# persists in the database and overrides the values here without a redeploy.
#
# `.env` is gitignored — never commit real secrets. `.env.example` is committed.

# ── Agent: web search (optional) ────────────────────────────────────────────
# Tavily API key for the agent's web_search tool. If absent, web_search returns
# a graceful "unavailable" string and the rest of the app is unaffected.
TAVILY_API_KEY=

# ── Agent: LLM endpoint (defaults; runtime-overridable from the UI) ──────────
# OpenAI-compatible base URL ending in /v1. Point this at any OpenAI-compatible
# server (local or remote).
AGENT_LLM_BASE_URL=http://llama-cpp:8080/v1
# The OpenAI SDK requires a non-empty value; set a real key only if your endpoint
# authenticates, otherwise leave the placeholder.
AGENT_LLM_API_KEY=no-key
# Must match what the endpoint's /v1/models reports.
AGENT_MODEL=Qwen_Qwen3.5-9B-Q6_K.gguf

# ── Agent: behavior tuning (optional) ───────────────────────────────────────
AGENT_MAX_STEPS=30
# AGENT_EMPTY_RETRIES=2          # re-prompts when the model returns empty content
# AGENT_MAX_CONVERSATIONS=200    # persisted chats kept (most-recent-N)
# AGENT_APPROVAL_TIMEOUT=180     # seconds to wait for a root_bash/post approval
# AGENT_BASH_TIMEOUT=60          # root_bash command timeout (seconds)
# AGENT_BASH_AUTO_APPROVE=1      # 0 disables auto-running provably read-only commands

# ── Database (optional) ─────────────────────────────────────────────────────
# Postgres DSN. Defaults to the in-compose `postgress` service. Override to point
# at a different host/credentials/database on another machine.
# DATABASE_URL=postgresql://app:hackme@postgress:5432/admindash
